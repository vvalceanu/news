# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# true/1/yes to enable. Leave empty in production.
DJANGO_DEBUG=
# Comma-separated, no wildcard. Example: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=
# Comma-separated full origins. Example: https://news.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Admin path, without slashes. Must not be "admin". Pick something unguessable.
DJANGO_ADMIN_URL=
# Postgres connection URL. On Railway, reference the Postgres service's DATABASE_URL.
# Optional locally when DJANGO_DEBUG is on (falls back to SQLite).
DATABASE_URL=
# Staging only: set both to put the whole site behind HTTP Basic Auth. Leave empty in production.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Miniflux base URL, without /v1. On Railway: http://${{<miniflux-service>.RAILWAY_PRIVATE_DOMAIN}}:<port>
MINIFLUX_URL=
# Miniflux API key: Miniflux UI > Settings > API Keys.
MINIFLUX_API_KEY=
